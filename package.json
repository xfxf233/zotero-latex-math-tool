{
  "name": "zotero-latex-math-tool",
  "type": "module",
  "version": "0.1.1",
  "description": "Insert, edit, and render LaTeX math equations directly on PDF pages.",
  "config": {
    "addonName": "Zotero Latex Math Tool",
    "addonID": "zotero-latex-math-tool@xfxf233.github.io",
    "addonRef": "mathtool",
    "addonInstance": "MathTool",
    "prefsPrefix": "extensions.zotero.mathtool"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xfxf233/zotero-latex-math-tool.git"
  },
  "author": "xfxf233",
  "bugs": {
    "url": "https://github.com/xfxf233/zotero-latex-math-tool/issues"
  },
  "homepage": "https://github.com/xfxf233/zotero-latex-math-tool#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "katex": "^0.18.1",
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/katex": "^0.16.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^10.8.0",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
